{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "preview": "npx -y serve -s dist/portfolio/browser -l 4200",
    "deploy": "npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker build -t bachir-portfolio:latest .",
    "docker:run": "docker run -d -p 8080:80 --name bachir-portfolio bachir-portfolio:latest",
    "docker:stop": "docker stop bachir-portfolio && docker rm bachir-portfolio",
    "docker:compose": "docker compose up -d --build",
    "docker:compose:down": "docker compose down"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
